[Unit]
Description=Continuous Antigravity worker for NSMITTY MVP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nytr/nssmitty
ExecStart=/home/nytr/nssmitty/automation/run-antigravity-stream.sh
Restart=on-failure
RestartSec=60
TimeoutStopSec=120
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/nytr/nssmitty /home/nytr/.gemini/antigravity-cli
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=default.target
